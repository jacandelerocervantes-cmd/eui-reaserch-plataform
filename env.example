# ============================================================================
# .env.example — checklist consolidado de credenciales (CORRE 11)
# ============================================================================
# Copia este archivo a .env.local (Next.js) y configura las mismas claves
# como secrets del proyecto Supabase para las Edge Functions
# (`supabase secrets set NOMBRE=valor`, ver deploy/deploy_edge_functions.sh).
#
# Cada variable trae: qué es, si es OBLIGATORIA u OPCIONAL, y de dónde se
# obtiene. Corre `node scripts/check_env.mjs` después de llenar este archivo
# (como .env.local) para validar que no falte ninguna obligatoria.
# ============================================================================


# ── Supabase — núcleo de la plataforma (OBLIGATORIAS) ──────────────────────

# URL pública del proyecto. Dashboard de Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Anon key pública (segura de exponer en el bundle del navegador). Mismo panel.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Igual que las dos de arriba pero SIN el prefijo NEXT_PUBLIC_ — las usan las
# Edge Functions (Deno.env.get), no el frontend. Supabase las inyecta
# automáticamente en cada función desplegada, pero deben existir aquí para
# poder correr `supabase functions serve` en local.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Service role key — bypassa RLS. NUNCA debe llevar prefijo NEXT_PUBLIC_ ni
# exponerse al navegador. Dashboard → Project Settings → API → service_role.
# La usan varias Edge Functions (admin-*, provision-student-accounts,
# register-attendance) y un hook de asistencia en el frontend server-side.
SUPABASE_SERVICE_ROLE_KEY=

# Referencia del proyecto para `supabase link`/`supabase functions deploy`.
# Dashboard → Project Settings → General → Reference ID.
SUPABASE_PROJECT_REF=


# ── IA — Gemini (OBLIGATORIA para toda función que llama IA) ───────────────

# Google AI Studio (aistudio.google.com) → Get API key. Cubre también el
# endpoint de embeddings (text-embedding-004) que usa GraphRAG — no hace
# falta una key separada.
GEMINI_API_KEY=

# Opcionales — límites del semáforo interno de concurrencia hacia Gemini
# (_shared/gemini.ts). Sin definir, usan sus defaults ya testeados en código.
GEMINI_MAX_CONCURRENCY=
GEMINI_MAX_QUEUE=


# ── Seguridad — HMAC y cifrado (OBLIGATORIAS antes de producción) ──────────

# Firma HMAC de los QR de asistencia (register-attendance) y su verificación
# server-side (Next.js). Mismo valor en ambos lugares. Generar con:
#   openssl rand -hex 32
QR_HMAC_SECRET=

# Cifra/descifra la API key de Zotero guardada por el investigador
# (/api/profile/zotero-key). Solo Next.js, sin prefijo NEXT_PUBLIC_. Generar
# con: openssl rand -hex 32
PROFILE_ENCRYPTION_KEY=


# ── Caché/circuit breaker distribuido — Upstash Redis (OPCIONAL) ───────────

# Sin estas dos, el circuit breaker y la caché de proxy.ts funcionan en
# memoria por instancia (ya validado, ver docs/01_ARQUITECTURA_DEVOPS_FRUGAL.md).
# Con ellas, el estado se comparte entre instancias/regiones.
# Crear cuenta gratuita en upstash.com → Redis → Create database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=


# ── Fallback a SLM local (OPCIONAL) ─────────────────────────────────────────

# Si Gemini falla repetidamente y el circuit breaker se abre, sin esto solo
# lanza GeminiCircuitOpenError (comportamiento ya testeado). Con esto, cae a
# un modelo local (Ollama/LM Studio/vLLM propio en un servidor accesible
# desde las Edge Functions).
LOCAL_SLM_URL=
LOCAL_SLM_API_KEY=
LOCAL_SLM_MODEL=


# ── OCR — baidu/Unlimited-OCR autohospedado en GCP (OPCIONAL, capa aparte) ──

# Sin estas dos, isOcrConfigured() en _shared/ocrClient.ts devuelve false y
# las 3 funciones que lo usan (evaluate-submissions-ia, detect-cross-plagiarism,
# el guardrail de entrada de PDFs) hacen fallback automático al comportamiento
# actual (Gemini multimodal directo) — NUNCA autohospedar este modelo en la
# infraestructura frugal del proyecto, requiere GPU real (ver
# docs/05_OCR_Unlimited_Integracion.md).
# OCR_SERVICE_URL: URL del servicio Cloud Run desplegado con
#   deploy/ocr-unlimited/cloud-run-service.yaml (ej. https://unlimited-ocr-xxxx-uc.a.run.app/v1/chat/completions)
# OCR_SERVICE_TOKEN: identity/service-account token de esa Cloud Run
#   (Google Cloud Console → IAM → Service Accounts, o `gcloud auth print-identity-token`)
OCR_SERVICE_URL=
OCR_SERVICE_TOKEN=

# Opcionales — defaults ya testeados en código si se dejan vacíos.
OCR_MODEL=unlimited-ocr
OCR_MAX_REQUESTS_PER_DAY=200
OCR_MAX_FILE_SIZE_BYTES=15000000
OCR_TIMEOUT_MS=20000


# ── Apps Script — puente con Google Workspace (OBLIGATORIA si se usa Drive/Docs/Calendar) ──

# URL del webapp de Apps Script (appscript/Router.gs) que envuelve Drive,
# Docs, Slides, Forms, Tasks, Calendar. Desplegar el proyecto de Apps Script
# (script.google.com → tu proyecto → Deploy → New deployment → Web app) y
# copiar la URL /exec resultante.
APPS_SCRIPT_URL=

# Secret compartido para autenticar las llamadas de las Edge Functions hacia
# el webapp (mismo valor configurado como WEBHOOK_SECRET/APPS_SCRIPT_SECRET
# dentro del propio Router.gs). Generar con: openssl rand -hex 32
APPS_SCRIPT_SECRET=

# ID de la carpeta raíz de Drive donde el Master Copilot guarda documentos/
# presentaciones/rúbricas generados (copilot-execute-tool). Google Drive →
# clic derecho en la carpeta → Compartir → Copiar enlace → el ID es el
# segmento largo de la URL después de /folders/.
MASTER_FOLDER_ID=


# ── Frontend — mapas y URL pública (OBLIGATORIAS si se usan esas features) ──

# Google Cloud Console → APIs & Services → Credentials → API key, con
# "Maps JavaScript API" habilitada. Pública (va en el bundle del navegador).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# URL pública donde corre el frontend en producción (ej. https://tuapp.vercel.app).
# Usada para construir links absolutos (invitaciones, QR, etc.).
NEXT_PUBLIC_APP_URL=
